# ============================================================
# INSURANCE LEAD ENGINE - EXAMPLE ENVIRONMENT VARIABLES
# ============================================================
# DO NOT put real production secret values in this file.
# Copy only the required subset into the relevant platform's
# encrypted secret/environment-variable store.
# ============================================================

# ---------- General ----------
ENVIRONMENT=development
LOG_LEVEL=INFO
CAMPAIGN_NAME=
CAMPAIGN_CODE=

# ---------- GitHub / CI ----------
GITHUB_REPOSITORY_URL=
GITHUB_DEFAULT_BRANCH=main
CLOUDFLARE_ACCOUNT_ID=
# Secret in GitHub Actions:
CLOUDFLARE_API_TOKEN=

# ---------- Cloudflare resource identifiers ----------
R2_BUCKET_NAME=insurance-leads-raw-prod
D1_DATABASE_NAME=insurance-leads-prod
D1_DATABASE_ID=
ORCHESTRATOR_BASE_URL=
SENDER_BASE_URL=

# ---------- Service-to-service authentication ----------
# Generate independently with: openssl rand -hex 32
RENDER_SHARED_SECRET=
APPS_SCRIPT_API_TOKEN=
ADMIN_API_TOKEN=

# ---------- Render ----------
RENDER_BASE_URL=
ORCHESTRATOR_SHARED_SECRET=
PROCESSING_BATCH_SIZE=1000

# ---------- xAI / Grok ----------
XAI_API_KEY=
XAI_MODEL=

# ---------- Source: Bluesky ----------
BLUESKY_JETSTREAM_HOST=jetstream.us-east.bsky.network
BLUESKY_COLLECTION=app.bsky.feed.post

# ---------- Source: YouTube ----------
YOUTUBE_API_KEY=

# ---------- Google Sheet ----------
GOOGLE_SHEET_URL=
GOOGLE_SPREADSHEET_ID=
APPS_SCRIPT_SCRIPT_ID=

# ---------- MWEB ----------
MWEB_SMTP_HOST=smtp.mweb.co.za
MWEB_SMTP_PORT=587
MWEB_SMTP_USERNAME=
MWEB_SMTP_PASSWORD=
MWEB_FROM_EMAIL=
MWEB_FROM_NAME=

# Optional IMAP reply-ingestion later
MWEB_IMAP_HOST=imap.mweb.co.za
MWEB_IMAP_PORT=993

# ---------- Business / Compliance ----------
MARKETING_FORWARD_EMAIL=
RESPONSIBLE_PARTY_NAME=
RESPONSIBLE_PARTY_CONTACT_EMAIL=
RESPONSIBLE_PARTY_CONTACT_PHONE=
PRIVACY_NOTICE_URL=
COMPLIANCE_APPROVED_TEMPLATE_VERSION=

# ---------- Safety defaults ----------
ACQUISITION_ENABLED=false
PROCESSING_ENABLED=false
MWEB_SENDING_APPROVED=false
SENDER_ENABLED=false

RAW_DAILY_TARGET=30000
GROK_DAILY_CANDIDATE_CAP=5000
D1_DAILY_WRITE_SOFT_CAP=75000
