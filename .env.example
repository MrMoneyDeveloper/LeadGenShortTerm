# LeadGenShortTerm — data-phase environment template
# Never commit real secret values.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Render PostgreSQL injects DATABASE_URL when linked.
DATABASE_URL=

# Processing
PROCESSING_BATCH_SIZE=500
RAW_RETENTION_DAYS=3
DELETE_REJECTED_RAW=true
RAW_DAILY_TARGET=30000

# Grok / xAI
XAI_API_KEY=
XAI_MODEL=
GROK_DAILY_CANDIDATE_CAP=5000

# Bluesky Jetstream
BLUESKY_JETSTREAM_HOST=jetstream.us-east.bsky.network
BLUESKY_COLLECTION=app.bsky.feed.post

# YouTube Data API
YOUTUBE_API_KEY=

# Google dashboard/export phase — optional until backend works
GOOGLE_SHEET_URL=
GOOGLE_SPREADSHEET_ID=
APPS_SCRIPT_SCRIPT_ID=

# Outbound email is intentionally disabled in the data MVP.
MWEB_SENDING_APPROVED=false
SENDER_ENABLED=false
